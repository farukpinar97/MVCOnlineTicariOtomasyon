@using MVCOnlineTicariOtomasyon.Models.Entities
@using PagedList
@model IPagedList<Category>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string q = ViewBag.Query;
}

@if (Model.TotalItemCount == 0 && q == null)
{
    <div class="empty-state">
        <h2>Henüz kategori yok</h2>
        <p>Ürünleri gruplamak için ilk kategoriyi ekle.</p>
        <a class="btn btn-primary" href="@Url.Action("CategoryAdd")"><i class="fas fa-plus mr-2"></i>Kategori ekle</a>
    </div>
}
else
{
    <div class="page-bar">
        <div class="page-bar__lead">
            @* Arama sunucuda yapılır *@
            <form class="list-search" method="get" action="@Url.Action("Index")" role="search">
                <i class="fas fa-search list-search__icon" aria-hidden="true"></i>
                <input class="form-control" type="search" name="q" value="@q" placeholder="Kategori ara" aria-label="Kategori ara" maxlength="30" autocomplete="off" />
            </form>
            <p class="page-bar__info">
                @if (q == null)
                {
                    @:@Model.TotalItemCount kategori
                }
                else
                {
                    @:“@q” için @Model.TotalItemCount sonuç <a class="page-bar__clear" href="@Url.Action("Index")">Aramayı temizle</a>
                }
            </p>
        </div>
        <a class="btn btn-primary" href="@Url.Action("CategoryAdd")"><i class="fas fa-plus mr-2"></i>Kategori ekle</a>
    </div>

    if (Model.TotalItemCount == 0)
    {
        <div class="empty-state">
            <h2>Eşleşen kategori yok</h2>
            <p>“@q” adını içeren bir kategori bulunamadı.</p>
            <a class="btn btn-light" href="@Url.Action("Index")">Bütün kategorileri göster</a>
        </div>
    }
    else
    {
        @* data-search="off" *@
        <table class="table table-bordered" data-search="off">
            <thead>
                <tr>
                    <th class="cell-fit">ID</th>
                    <th>Kategori adı</th>
                    <th class="cell-fit cell-num">Ürün sayısı</th>
                    <th class="cell-actions">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var productCount = item.Products == null ? 0 : item.Products.Count;

                    <tr>
                        <td>@item.CategoryId</td>
                        <td>@item.CategoryName</td>
                        <td class="cell-num">@productCount</td>
                        <td class="cell-actions">
                            <a class="btn btn-light" href="@Url.Action("CategoryGet", new { id = item.CategoryId })"><i class="fas fa-pen mr-1"></i>Güncelle</a>

                            @if (productCount > 0)
                            {
                                @* İçinde ürün olan kategori silinemez *@
                                <span class="d-inline-block" title="İçinde ürün olduğu için silinemez">
                                    <button type="button" class="btn btn-outline-danger" disabled><i class="fas fa-trash-alt mr-1"></i>Sil</button>
                                </span>
                            }
                            else
                            {
                                @* Adrese sayfa ve arama da eklenir *@
                                <button type="button" class="btn btn-outline-danger"
                                        data-toggle="modal" data-target="#deleteModal"
                                        data-delete-url="@Url.Action("CategoryDelete", new { id = item.CategoryId, page = Model.PageNumber, q })"
                                        data-delete-name="@item.CategoryName">
                                    <i class="fas fa-trash-alt mr-1"></i>Sil
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @Html.Partial("_Pager", Model)
    }
}
