@using MVCOnlineTicariOtomasyon.Models.Entities
@model List<Current>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Controller'ın hazırladığı sayılar
    var salesCounts = (Dictionary<int, int>)ViewBag.SalesCounts;
}

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Henüz cari yok</h2>
        <p>Satış yapabilmek için önce müşteriyi cari olarak ekle.</p>
        <a class="btn btn-primary" href="@Url.Action("CurrentAdd")"><i class="fas fa-plus mr-2"></i>Cari ekle</a>
    </div>
}
else
{
    <div class="page-bar">
        <p class="page-bar__info">@Model.Count cari</p>
        <a class="btn btn-primary" href="@Url.Action("CurrentAdd")"><i class="fas fa-plus mr-2"></i>Cari ekle</a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="cell-fit">ID</th>
                <th>Ad soyad</th>
                <th>Şehir</th>
                <th>E-posta</th>
                <th class="cell-fit cell-num">Satış sayısı</th>
                <th class="cell-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var salesCount = salesCounts.ContainsKey(item.CurrentId) ? salesCounts[item.CurrentId] : 0;

                // Onay penceresinde yazacak açıklama
                var deleteText = "Cari listeden kalkar ve panelden geri alınamaz.";
                if (salesCount > 0)
                {
                    deleteText += " Geçmişteki " + salesCount + " satış kaydı silinmez.";
                }

                <tr>
                    <td>@item.CurrentId</td>
                    <td>@item.CurrentName @item.CurrentSurname</td>
                    <td>@item.CurrentCity</td>
                    <td>
                        @if (!String.IsNullOrWhiteSpace(item.CurrentMail))
                        {
                            <a href="mailto:@item.CurrentMail">@item.CurrentMail</a>
                        }
                    </td>
                    <td class="cell-num">@salesCount</td>
                    <td class="cell-actions">
                        <a class="btn btn-light" href="@Url.Action("CurrentSales", new { id = item.CurrentId })"><i class="fas fa-receipt mr-1"></i>Satış geçmişi</a>
                        <a class="btn btn-light" href="@Url.Action("CurrentGet", new { id = item.CurrentId })"><i class="fas fa-pen mr-1"></i>Güncelle</a>
                        <button type="button" class="btn btn-outline-danger"
                                data-toggle="modal" data-target="#deleteModal"
                                data-delete-url="@Url.Action("CurrentDelete", new { id = item.CurrentId })"
                                data-delete-name="@item.CurrentName @item.CurrentSurname"
                                data-delete-text="@deleteText">
                            <i class="fas fa-trash-alt mr-1"></i>Sil
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
