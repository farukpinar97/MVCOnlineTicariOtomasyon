@model MVCOnlineTicariOtomasyon.Models.Entities.Invoice

@{
    ViewBag.PageTitle = "Faturayı güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using (Html.BeginForm("InvoiceUpdate", "Invoice", FormMethod.Post, new { @class = "card form-card form-card--wide" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.InvoiceId)

    <div class="card-body">
        @Html.Partial("_InvoiceForm")
    </div>

    <div class="card-footer">
        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a class="btn btn-light" href="@Url.Action("InvoiceDetail", new { id = Model.InvoiceId })">Vazgeç</a>
    </div>
}
