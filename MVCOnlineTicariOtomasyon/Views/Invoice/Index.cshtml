@using MVCOnlineTicariOtomasyon.Models.Entities
@model List<Invoice>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var tr = new System.Globalization.CultureInfo("tr-TR");
    var today = DateTime.Today;

    // Özet bandı
    decimal grandTotal = Model.Sum(x => x.InvoiceItems == null ? 0m : x.InvoiceItems.Sum(i => i.InvoiceItemTotalPrice));
    int monthCount = Model.Count(x => x.InvoiceDate.Year == today.Year && x.InvoiceDate.Month == today.Month);
    int emptyCount = Model.Count(x => x.InvoiceItems == null || x.InvoiceItems.Count == 0);
}

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Henüz fatura yok</h2>
        <p>Önce faturayı oluştur, sonra içine kalemlerini ekle.</p>
        <a class="btn btn-primary" href="@Url.Action("InvoiceAdd")"><i class="fas fa-plus mr-2"></i>Fatura ekle</a>
    </div>
}
else
{
    <div class="page-bar">
        <p class="page-bar__info">@Model.Count fatura</p>
        <a class="btn btn-primary" href="@Url.Action("InvoiceAdd")"><i class="fas fa-plus mr-2"></i>Fatura ekle</a>
    </div>

    <dl class="summary">
        <div class="summary__item">
            <dt>Faturaların toplam tutarı</dt>
            <dd>@grandTotal.ToString("C2", tr)</dd>
        </div>
        <div class="summary__item">
            <dt>Bu ay kesilen</dt>
            <dd>@monthCount fatura</dd>
        </div>
        <div class="summary__item @(emptyCount > 0 ? "is-warning" : null)">
            <dt>Kalemi girilmemiş</dt>
            <dd>@emptyCount fatura</dd>
        </div>
    </dl>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="cell-fit">Fatura no</th>
                <th class="cell-fit">Tarih</th>
                <th>Teslim alan</th>
                <th>Teslim eden</th>
                <th>Vergi dairesi</th>
                <th class="cell-fit cell-num">Kalem</th>
                <th class="cell-fit cell-num">Toplam</th>
                <th class="cell-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var itemCount = item.InvoiceItems == null ? 0 : item.InvoiceItems.Count;
                var total = item.InvoiceItems == null ? 0m : item.InvoiceItems.Sum(i => i.InvoiceItemTotalPrice);

                <tr>
                    <td class="cell-fit">@item.InvoiceSerialNo @item.InvoiceOrderNo</td>
                    <td class="cell-fit">@item.InvoiceDate.ToString("dd.MM.yyyy", tr) @item.InvoiceTime</td>
                    <td>@item.Receiver</td>
                    <td>@item.Deliverer</td>
                    <td>@item.TaxOffice</td>
                    <td class="cell-num">@itemCount</td>
                    <td class="cell-fit cell-num">@total.ToString("C2", tr)</td>
                    <td class="cell-actions">
                        <a class="btn btn-light" href="@Url.Action("InvoiceDetail", new { id = item.InvoiceId })"><i class="fas fa-file-invoice mr-1"></i>Fatura</a>
                        <a class="btn btn-light" href="@Url.Action("InvoiceGet", new { id = item.InvoiceId })"><i class="fas fa-pen mr-1"></i>Güncelle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
