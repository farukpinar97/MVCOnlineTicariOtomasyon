@using MVCOnlineTicariOtomasyon.Models.Entities
@model List<SalesTransaction>

@{
    ViewBag.PageTitle = "Satışlar: " + ViewBag.PersonnelName;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var tr = new System.Globalization.CultureInfo("tr-TR");

    // Tablonun altındaki toplam satırı
    var totalQuantity = Model.Sum(x => x.SalesTransactionQuantity);
    var totalPrice = Model.Sum(x => x.SalesTransactionTotalPrice);

    // Geri dönüş
    bool fromPersonnel = Request.QueryString["source"] == "personnel";
    int? departmentId = ViewBag.DepartmentId;

    var backText = fromPersonnel ? "Personellere dön" : "Departmana dön";
    var backUrl = Url.Action("Index");
    if (fromPersonnel)
    {
        backUrl = Url.Action("Index", "Personnel");
    }
    else if (departmentId.HasValue)
    {
        backUrl = Url.Action("DepartmentDetail", new { id = departmentId.Value });
    }
}

<div class="page-bar">
    <p class="page-bar__info">@Model.Count satış</p>
    <div class="page-bar__actions">
        <a class="btn btn-light" href="@backUrl"><i class="fas fa-arrow-left mr-2"></i>@backText</a>
        @if (Model.Count > 0)
        {
            <button type="button" class="btn btn-light" onclick="window.print()"><i class="fas fa-print mr-2"></i>Yazdır</button>
        }
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Bu personelin satışı yok</h2>
        <p>Personel bir satış yaptığında burada listelenir.</p>
    </div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="cell-fit">Satış no</th>
                <th class="cell-fit">Tarih</th>
                <th>Ürün</th>
                <th>Cari</th>
                <th class="cell-fit cell-num">Adet</th>
                <th class="cell-fit cell-num">Birim fiyat</th>
                <th class="cell-fit cell-num">Toplam</th>
                <th class="cell-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SalesTransactionId</td>
                    <td class="cell-fit">@String.Format(tr, "{0:dd.MM.yyyy}", item.SalesTransactionDate)</td>
                    <td>@item.Product.ProductName</td>
                    <td>@item.Current.CurrentName @item.Current.CurrentSurname</td>
                    <td class="cell-num">@item.SalesTransactionQuantity</td>
                    <td class="cell-fit cell-num">@String.Format(tr, "{0:C2}", item.SalesTransactionUnitPrice)</td>
                    <td class="cell-fit cell-num">@String.Format(tr, "{0:C2}", item.SalesTransactionTotalPrice)</td>
                    <td class="cell-actions">
                        <a class="btn btn-light" href="@Url.Action("SalesDetail", "Sales", new { id = item.SalesTransactionId })"><i class="fas fa-file-invoice mr-1"></i>Fiş</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4">Toplam</th>
                <td class="cell-num">@String.Format(tr, "{0:N0}", totalQuantity)</td>
                <td></td>
                <td class="cell-fit cell-num">@String.Format(tr, "{0:C2}", totalPrice)</td>
                <td class="cell-actions"></td>
            </tr>
        </tfoot>
    </table>
}
