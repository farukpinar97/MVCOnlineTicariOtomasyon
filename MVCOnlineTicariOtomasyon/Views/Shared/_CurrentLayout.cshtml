@* Cari paneli şablonu *@
@{
    Layout = null;

    // Menü tek yerden yönetiliyor
    var tabs = new[]
    {
        new { Text = "Profilim",     Action = "Index",    Icon = "fa-user",         Ready = true },
        new { Text = "Siparişlerim", Action = "Orders",   Icon = "fa-shopping-bag", Ready = true },
        new { Text = "Kargo takibi", Action = "Cargo",    Icon = "fa-truck",        Ready = true  },
        new { Text = "Mesajlar",     Action = "Messages", Icon = "fa-envelope",     Ready = true }
    };

    // Seçili sekme
    var currentAction = (ViewBag.ActiveTab as string) ?? ViewContext.RouteData.GetRequiredString("action");
    var activeTab = tabs.FirstOrDefault(t => string.Equals(t.Action, currentAction, StringComparison.OrdinalIgnoreCase));
    string pageTitle = (ViewBag.PageTitle as string) ?? (activeTab != null ? activeTab.Text : "Cari paneli");

    // Okunmamış mesaj sayısı
    int unreadCount = ViewBag.UnreadCount ?? 0;

    // Ad ve e-posta controller'dan gelir
    string fullName = (ViewBag.CurrentFullName as string) ?? "";
    string mail = ViewBag.CurrentMail as string;
    string initials = String.Concat(fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w.Substring(0, 1))).ToUpper();

    // Tema dosyalarının adresine son değişme zamanı eklenir
    Func<string, string> versioned = path =>
        Url.Content(path) + "?v=" + System.IO.File.GetLastWriteTimeUtc(Server.MapPath(path)).Ticks;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Cari paneli</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=IBM+Plex+Sans:400,500,600%7CIBM+Plex+Sans+Condensed:600&amp;subset=latin-ext&amp;display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@versioned("~/Content/admin/admin.css")" />
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>
</head>
<body class="cp">
    <div class="cp-shell">

        <aside class="cp-side">
            <a class="cp-brand" href="@Url.Action("Index", "CurrentPanel")">
                <span class="app-brand__mark" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M6 2v14M2 7h14M2 12h14" />
                    </svg>
                </span>
                <span>
                    <span class="cp-brand__name">Ticari Otomasyon</span>
                    <span class="cp-brand__sub">Cari paneli</span>
                </span>
            </a>

            @* Kimlik kutusu *@
            <div class="cp-me">
                <span class="cp-me__avatar" aria-hidden="true">@initials</span>
                <span class="cp-me__text">
                    <span class="cp-me__name">@fullName</span>
                    @if (!String.IsNullOrEmpty(mail))
                    {
                        <span class="cp-me__mail">@mail</span>
                    }
                </span>
            </div>

            <nav class="cp-nav" aria-label="Cari paneli">
                @foreach (var tab in tabs)
                {
                    if (tab.Ready)
                    {
                        var isActive = activeTab != null && tab.Action == activeTab.Action;

                        <a class="cp-nav__link @(isActive ? "is-active" : null)" href="@Url.Action(tab.Action, "CurrentPanel")" aria-current="@(isActive ? "page" : null)">
                            <i class="fas @tab.Icon fa-fw" aria-hidden="true"></i><span>@tab.Text</span>
                            @if (tab.Action == "Messages" && unreadCount > 0)
                            {
                                <span class="cp-nav__count" title="Okunmamış mesaj">@unreadCount<span class="sr-only"> okunmamış</span></span>
                            }
                        </a>
                    }
                    else
                    {
                        <span class="cp-nav__link is-soon" aria-disabled="true">
                            <i class="fas @tab.Icon fa-fw" aria-hidden="true"></i><span>@tab.Text</span>
                            <span class="cp-nav__soon">Yakında</span>
                        </span>
                    }
                }
            </nav>

            @* Çıkış POST ile yapılır *@
            <form class="cp-side__logout" method="post" action="@Url.Action("Logout", "Login")">
                @Html.AntiForgeryToken()
                <button type="submit" class="cp-nav__link"><i class="fas fa-sign-out-alt fa-fw" aria-hidden="true"></i><span>Çıkış yap</span></button>
            </form>
        </aside>

        <main class="cp-main">
            <div class="cp-content">
                <h1 class="cp-title">@pageTitle</h1>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible app-flash" role="status">
                        <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible app-flash" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
                    </div>
                }

                @RenderBody()
            </div>

            <footer class="cp-foot">&copy; @DateTime.Now.Year Ticari Otomasyon</footer>
        </main>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>
    <script src="@versioned("~/Content/admin/admin.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
