@{
    // Hata sayfası panellerin layout'unu kullanmaz
    Layout = null;

    string requestedPath = ViewBag.RequestedPath;
    string homeUrl = ViewBag.HomeUrl;
    string homeText = ViewBag.HomeText;

    var tr = new System.Globalization.CultureInfo("tr-TR");

    Func<string, string> versioned = path =>
        Url.Content(path) + "?v=" + System.IO.File.GetLastWriteTimeUtc(Server.MapPath(path)).Ticks;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sayfa bulunamadı - Ticari Otomasyon</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=IBM+Plex+Sans:400,500,600%7CIBM+Plex+Sans+Condensed:600%7CIBM+Plex+Mono:600&amp;subset=latin-ext&amp;display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@versioned("~/Content/admin/admin.css")" />
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>
</head>
<body class="error-page">

    <main class="error">

        <div class="error__brand">
            <span class="app-brand__mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M6 2v14M2 7h14M2 12h14" />
                </svg>
            </span>
            <span>Ticari Otomasyon</span>
        </div>

        @* Defter temasına uygun bir "fiş" *@
        <div class="error-slip-shadow">
        <section class="error-slip" aria-labelledby="errorTitle">
            <div class="error-slip__head">
                <span class="error-slip__label">Kayıt fişi</span>
                <span class="error-slip__stamp">Bulunamadı</span>
            </div>

            <h1 class="error-slip__code" aria-hidden="true">404</h1>
            <h2 class="error-slip__title" id="errorTitle">Aradığın sayfa defterde yok</h2>
            <p class="error-slip__text">Adres yanlış yazılmış, sayfa taşınmış ya da kayıt silinmiş olabilir.</p>

            <dl class="error-slip__lines">
                @if (!String.IsNullOrEmpty(requestedPath))
                {
                    <div>
                        <dt>Adres</dt>
                        <dd class="error-slip__path">@requestedPath</dd>
                    </div>
                }
                <div>
                    <dt>Tarih</dt>
                    <dd>@DateTime.Now.ToString("d MMMM yyyy, HH:mm", tr)</dd>
                </div>
                <div>
                    <dt>Durum</dt>
                    <dd>Sayfa bulunamadı</dd>
                </div>
                <div class="error-slip__total">
                    <dt>Hata kodu</dt>
                    <dd>404</dd>
                </div>
            </dl>

            <div class="error-slip__actions">
                <a class="btn btn-primary" href="@homeUrl"><i class="fas fa-home mr-2" aria-hidden="true"></i>@homeText</a>
                <button type="button" class="btn btn-light" onclick="history.length > 1 ? history.back() : location.assign('@homeUrl')">
                    <i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>Geri dön
                </button>
            </div>
        </section>
        </div>

        <p class="error__foot">&copy; @DateTime.Now.Year Ticari Otomasyon</p>
    </main>

</body>
</html>
