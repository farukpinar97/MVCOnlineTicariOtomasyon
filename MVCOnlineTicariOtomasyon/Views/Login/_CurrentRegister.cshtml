@model MVCOnlineTicariOtomasyon.Models.Entities.Current

@* Kayıt penceresinin içi *@

@using (Html.BeginForm("CurrentRegister", "Login", FormMethod.Post, new { @class = "register-form" }))
{
    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h2 class="modal-title" id="registerTitle">Cari olarak kayıt ol</h2>
        <button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>

    <div class="modal-body">
        <p class="modal-form__error alert alert-danger" role="alert" hidden>Kayıt gönderilemedi. Bağlantını kontrol edip tekrar dene.</p>

        <div class="form-row">
            <div class="form-group col-sm-6">
                @Html.LabelFor(x => x.CurrentName)
                @Html.TextBoxFor(x => x.CurrentName, new { @class = "form-control", maxlength = 30, required = "required", autocomplete = "given-name" })
                @Html.ValidationMessageFor(x => x.CurrentName)
            </div>
            <div class="form-group col-sm-6">
                @Html.LabelFor(x => x.CurrentSurname)
                @Html.TextBoxFor(x => x.CurrentSurname, new { @class = "form-control", maxlength = 30, required = "required", autocomplete = "family-name" })
                @Html.ValidationMessageFor(x => x.CurrentSurname)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(x => x.CurrentMail)
            @Html.TextBoxFor(x => x.CurrentMail, new { @class = "form-control", type = "email", maxlength = 50, required = "required", autocomplete = "email" })
            @Html.ValidationMessageFor(x => x.CurrentMail)
            <small class="form-text text-muted">Giriş yaparken bu adresi kullanacaksın.</small>
        </div>

        <div class="form-group">
            @Html.LabelFor(x => x.CurrentCity)
            @Html.TextBoxFor(x => x.CurrentCity, new { @class = "form-control", maxlength = 13, autocomplete = "address-level2" })
            @Html.ValidationMessageFor(x => x.CurrentCity)
            <small class="form-text text-muted">İsteğe bağlı.</small>
        </div>

        <div class="form-row">
            <div class="form-group col-sm-6 mb-sm-0">
                @Html.LabelFor(x => x.CurrentPassword)
                @Html.PasswordFor(x => x.CurrentPassword, new { @class = "form-control", minlength = 6, maxlength = 20, required = "required", autocomplete = "new-password" })
                @Html.ValidationMessageFor(x => x.CurrentPassword)
                <small class="form-text text-muted">6 ile 20 karakter arası.</small>
            </div>
            <div class="form-group col-sm-6 mb-0">
                <label for="PasswordRepeat">Şifre tekrar</label>
                <input class="form-control @(ViewData.ModelState.IsValidField("PasswordRepeat") ? null : "input-validation-error")"
                       id="PasswordRepeat" name="PasswordRepeat" type="password" maxlength="20" required autocomplete="new-password" />
                @Html.ValidationMessage("PasswordRepeat")
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-dismiss="modal">Vazgeç</button>
        <button type="submit" class="btn btn-primary">Kayıt ol</button>
    </div>
}
